{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "OPL",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "begin": "/\\*",
                    "end": "\\*/",
                    "name": "comment.block.opl"
                },
                {
                    "match": "//.*$",
                    "name": "comment.line.double-slash.opl"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.opl",
                    "patterns": [
                        {
                            "match": "\\\\.",
                            "name": "constant.character.escape.opl"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(dvar|dexpr|minimize|maximize|subject to|constraints|forall|sum|if|else|execute|main|using|cp|allDifferent|pack|pulse|step|interval|sequence|in|assert|include|sorted|ordered)\\b",
                    "name": "keyword.control.opl"
                },
                {
                    "match": "\\b(min|max|abs|startOf|endOf|size|card|item|first|last|prev|next)\\b",
                    "name": "support.function.opl"
                },
                {
                    "match": "&&|\\|\\||!|==|!=|<=|>=|<|>|\\+|-|\\*|/|%|=",
                    "name": "keyword.operator.opl"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "\\b(int|float|boolean|range|tuple|string|setof)\\b",
                    "name": "support.type.opl"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
                    "name": "constant.numeric.opl"
                }
            ]
        }
    },
    "scopeName": "source.opl"
}
