{
  "name": "cplex-opl",
  "displayName": "CPLEX OPL",
  "description": "Native support for IBM ILOG CPLEX Optimization Programming Language (OPL) in Visual Studio Code.",
  "version": "1.5.0",
  "icon": "images/pluginIcon.png",
  "publisher": "Janulo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JAANULO/cplex-opl-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:opl",
    "onFile:*.mod",
    "onFile:*.dat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "opl",
        "aliases": ["OPL", "opl", "CPLEX"],
        "extensions": [".mod", ".dat"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "opl",
        "scopeName": "source.opl",
        "path": "./syntaxes/opl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "opl",
        "path": "./snippets/opl.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "cplex-opl-vscode.runModel",
        "title": "Run OPL Model",
        "icon": "$(play)"
      },
      {
        "command": "cplex-opl-vscode.generateDatSkeleton",
        "title": "Generate .dat Skeleton",
        "icon": "$(new-file)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "cplex-opl-vscode.runModel",
          "when": "resourceExtname == .mod || resourceExtname == .dat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "cplex-opl-vscode.generateDatSkeleton",
          "when": "resourceExtname == .mod",
          "group": "cplex@1"
        }
      ]
    },
    "fileIconThemes": [
      {
        "id": "opl-icons",
        "label": "CPLEX OPL Icons",
        "path": "./images/opl-icons.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CPLEX OPL",
      "properties": {
        "cplex-opl.oplrunPath": {
          "type": "string",
          "default": "",
          "description": "Path to the oplrun executable (e.g. C:\\Program Files\\IBM\\ILOG\\CPLEX_Studio221\\opl\\bin\\x64_win64\\oplrun.exe). If empty, it attempts auto-detect."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
